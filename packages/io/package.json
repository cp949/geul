{
  "name": "@cp949/geul-io",
  "version": "0.1.2",
  "description": "geul 문서와 HTML/Markdown(GFM) 간 변환 — exportHtml/importHtml/exportMarkdown/importMarkdown",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/geul.git",
    "directory": "packages/io"
  },
  "homepage": "https://github.com/cp949/geul/tree/main/packages/io#readme",
  "bugs": {
    "url": "https://github.com/cp949/geul/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./dist/preview.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./preview.css": "./dist/preview.css"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "browserslist": [
    "Chrome >= 75"
  ],
  "scripts": {
    "build": "tsc -b && cp src/preview.css dist/preview.css",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --root ../.. packages/io/test"
  },
  "dependencies": {
    "@cp949/geul-model": "workspace:*",
    "hast-util-from-parse5": "8.0.3",
    "hast-util-sanitize": "5.0.2",
    "parse5": "7.3.0",
    "rehype-stringify": "10.0.1",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-stringify": "11.0.0",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@types/node": "22.20.1",
    "hast-util-select": "6.0.4"
  }
}
