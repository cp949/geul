{
  "name": "@cp949/geul-core",
  "version": "0.1.2",
  "description": "Tiptap을 감싼 프레임워크 비의존 headless 블록 에디터 코어",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/geul.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/cp949/geul/tree/main/packages/core#readme",
  "bugs": {
    "url": "https://github.com/cp949/geul/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --root ../.. --project core"
  },
  "dependencies": {
    "@cp949/geul-io": "workspace:*",
    "@cp949/geul-model": "workspace:*",
    "@tiptap/core": "3.31.3",
    "@tiptap/pm": "3.31.3",
    "@tiptap/starter-kit": "3.31.3",
    "prosemirror-highlight": "0.16.0"
  },
  "devDependencies": {
    "@types/node": "22.20.1"
  }
}
