{
  "name": "@cp949/geul-model",
  "version": "0.1.2",
  "description": "geul 에디터의 독자 문서 JSON 스키마와 검증 — 프레임워크·DOM 비의존",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/geul.git",
    "directory": "packages/model"
  },
  "homepage": "https://github.com/cp949/geul/tree/main/packages/model#readme",
  "bugs": {
    "url": "https://github.com/cp949/geul/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "test": "vitest run --root ../.. packages/model/test"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
