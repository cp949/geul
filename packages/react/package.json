{
  "name": "@cp949/geul-react",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "./src/styles.scss",
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "browserslist": [
    "Chrome >= 75"
  ],
  "scripts": {
    "build": "tsc -b && sass --no-source-map src/styles.scss dist/_styles.raw.css && postcss dist/_styles.raw.css -o dist/styles.css && rm dist/_styles.raw.css",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.configs.json --noEmit",
    "test": "vitest run --root ../.. packages/react/test"
  },
  "dependencies": {
    "@cp949/geul-core": "workspace:*",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.1",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "postcss-cli": "11.0.1",
    "sass": "1.103.1"
  }
}
