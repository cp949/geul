{
  "name": "@cp949/geul-react",
  "version": "0.1.2",
  "description": "@cp949/geul-core 기반 React 바인딩과 에디터 UI 컴포넌트",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/geul.git",
    "directory": "packages/react"
  },
  "homepage": "https://github.com/cp949/geul/tree/main/packages/react#readme",
  "bugs": {
    "url": "https://github.com/cp949/geul/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "sideEffects": [
    "./src/styles.scss",
    "./dist/styles.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist",
    "!dist/tsconfig.tsbuildinfo"
  ],
  "browserslist": [
    "Chrome >= 75"
  ],
  "scripts": {
    "build": "tsc -b && esbuild dist/*.js --outdir=dist --target=chrome75 --format=esm --allow-overwrite --sourcemap --sources-content=false && sass --no-source-map src/styles.scss dist/_styles.raw.css && postcss dist/_styles.raw.css -o dist/styles.css && rm dist/_styles.raw.css",
    "dev": "sass --watch --no-source-map src/styles.scss dist/styles.css",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit && tsc -p tsconfig.configs.json --noEmit",
    "test": "vitest run --root ../.. packages/react/test"
  },
  "dependencies": {
    "@cp949/geul-core": "workspace:*",
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.0",
    "@types/node": "22.20.1",
    "autoprefixer": "10.5.4",
    "esbuild": "0.28.2",
    "postcss": "8.5.26",
    "postcss-cli": "11.0.1",
    "sass": "1.103.1"
  }
}
