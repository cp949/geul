{
  "name": "@cp949/geul",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/geul.git"
  },
  "homepage": "https://github.com/cp949/geul#readme",
  "bugs": {
    "url": "https://github.com/cp949/geul/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "typecheck": "turbo run typecheck && pnpm typecheck:e2e",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:perf": "playwright test --project=perf",
    "verify:packages": "pnpm lint && pnpm build && pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm check:licenses",
    "verify": "pnpm verify:packages && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "fast-check": "4.9.0",
    "jsdom": "27.0.1",
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
