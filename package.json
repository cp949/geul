{
  "name": "@cp949/geul",
  "private": true,
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/geul.git"
  },
  "homepage": "https://github.com/cp949/geul#readme",
  "bugs": {
    "url": "https://github.com/cp949/geul/issues"
  },
  "type": "module",
  "packageManager": "pnpm@12.4.1",
  "engines": {
    "node": ">=24.18.0"
  },
  "scripts": {
    "build": "turbo run build",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "changeset:publish": "pnpm build && changeset publish",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:escompat": "node scripts/check-escompat.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "demo": "pnpm --filter @cp949/geul-demo dev",
    "dev": "turbo run dev --parallel",
    "format": "oxfmt --write \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,scss}\"",
    "format:check": "oxfmt --check \"**/*.{js,jsx,mjs,cjs,ts,tsx,mts,cts,json,jsonc,css,scss}\"",
    "lint": "eslint .",
    "scan:test-helpers": "node scripts/find-duplicate-test-helpers.mjs",
    "showcase": "pnpm --filter @cp949/geul-showcase dev",
    "typecheck": "turbo run typecheck && pnpm typecheck:configs && pnpm typecheck:e2e && pnpm typecheck:tests && pnpm typecheck:scripts",
    "typecheck:configs": "tsc -p tsconfig.configs.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium --project=mobile",
    "test:e2e:full": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:chrome83": "docker build -t geul-chrome83 docker/chrome83 && docker run --rm --network host --user \"$(id -u):$(id -g)\" -e pnpm_config_verify_deps_before_run=false -e npm_config_manage_package_manager_versions=false -e GEUL_CHROME83_WEBSERVER=1 -v \"$(pwd)\":/repo -w /repo geul-chrome83 ./node_modules/.bin/playwright test --project=chrome83",
    "test:e2e:perf": "playwright test --project=perf",
    "verify": "node scripts/verify.mjs full",
    "verify:quick": "node scripts/verify.mjs quick",
    "verify:failed": "node scripts/verify.mjs failed"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.0",
    "@types/node": "22.20.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.14.0",
    "eslint-plugin-es-x": "10.1.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "fast-check": "4.10.2",
    "globals": "17.14.0",
    "jsdom": "31.0.0",
    "oxfmt": "0.78.0",
    "turbo": "2.11.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
