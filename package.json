{
  "name": "@cp949/geul",
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cp949/geul.git"
  },
  "homepage": "https://github.com/cp949/geul#readme",
  "bugs": {
    "url": "https://github.com/cp949/geul/issues"
  },
  "type": "module",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "check:boundaries": "node scripts/check-package-boundaries.mjs",
    "check:escompat": "node scripts/check-escompat.mjs",
    "check:licenses": "node scripts/check-licenses.mjs",
    "dev": "turbo run dev --parallel",
    "lint": "biome check .",
    "scan:test-helpers": "node scripts/find-duplicate-test-helpers.mjs",
    "typecheck": "turbo run typecheck && pnpm typecheck:configs && pnpm typecheck:e2e && pnpm typecheck:tests && pnpm typecheck:scripts",
    "typecheck:configs": "tsc -p tsconfig.configs.json --noEmit",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json --noEmit",
    "typecheck:scripts": "tsc -p scripts/tsconfig.json --noEmit",
    "typecheck:tests": "tsc -p tests/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:full": "playwright test --project=chromium --project=firefox --project=webkit",
    "test:e2e:chrome83": "docker build -t geul-chrome83 docker/chrome83 && docker run --rm --network host --user \"$(id -u):$(id -g)\" -e pnpm_config_verify_deps_before_run=false -e GEUL_CHROME83_WEBSERVER=1 -v \"$(pwd)\":/repo -w /repo geul-chrome83 ./node_modules/.bin/playwright test --project=chrome83",
    "test:e2e:perf": "playwright test --project=perf",
    "verify:packages": "pnpm lint && pnpm build && pnpm check:escompat && pnpm typecheck && pnpm test && pnpm check:boundaries && pnpm check:licenses",
    "verify": "pnpm verify:packages && pnpm test:e2e"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.11",
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.5",
    "eslint": "10.9.1",
    "eslint-plugin-es-x": "10.0.0",
    "fast-check": "4.9.0",
    "jsdom": "27.0.1",
    "turbo": "2.10.9",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vitest": "4.1.10"
  }
}
